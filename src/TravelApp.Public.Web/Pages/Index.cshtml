        autoPlayRouteNext = PublicText.T("Đang chuyển sang POI tiếp theo: {0}", "次の POI に移動しています: {0}", "Wechsel zum nächsten POI: {0}", "Moving to the next POI: {0}"),
        ttsAutoplayBlocked = PublicText.T("Trình duyệt chưa cho phép phát tự động. Hãy nhấn Đọc bằng trình duyệt.", "ブラウザが自動再生を許可していません。『ブラウザで読み上げ』を押してください。", "Der Browser erlaubt keine automatische Wiedergabe. Bitte auf ‚Im Browser vorlesen‘ klicken.", "The browser hasn't allowed autoplay yet. Please press Read in browser."),
        ttsAutoplaying = PublicText.T("Đang phát tự động nội dung TTS.", "TTS コンテンツを自動再生しています。", "TTS-Inhalt wird automatisch abgespielt.", "Auto-playing TTS content."),
        historyNone = PublicText.T("Chưa có lịch sử nghe.", "聴取履歴はまだありません。", "Noch kein Hörverlauf.", "No listening history yet."),
        playAudio = PublicText.T("Phát audio", "オーディオ再生", "Audio abspielen", "Play audio"),
        openRoute = PublicText.T("Mở route", "ルートを開く", "Route öffnen", "Open route"),
        directions = PublicText.T("Chỉ đường", "ルート案内", "Wegbeschreibung", "Directions"),
        openPoi = PublicText.T("Mở POI", "POI を開く", "POI öffnen", "Open POI"),
        poiLabel = PublicText.T("POI", "POI", "POI", "POI"),
        overview = PublicText.T("Tổng quan", "概要", "Übersicht", "Overview"),
        map = PublicText.T("Bản đồ", "地図", "Karte", "Map"),
        listen = PublicText.T("Nghe", "再生", "Anhören", "Listen"),
        history = PublicText.T("Lịch sử", "履歴", "Verlauf", "History"),
        scanQrExperience = PublicText.T("Trải nghiệm QR công khai", "公開 QR 体験", "Öffentliche QR-Erfahrung", "Public QR experience"),
        publicTour = PublicText.T("Tour public", "公開ツアー", "Öffentliche Tour", "Public tour"),
        listeningHistory = PublicText.T("Lịch sử nghe", "聴取履歴", "Hörverlauf", "Listening history"),
        notes = PublicText.T("Ghi chú", "備考", "Hinweis", "Notes"),
        publicDataOnly = PublicText.T("Public data only", "公開データのみ", "Nur öffentliche Daten", "Public data only"),
        mobileFriendly = PublicText.T("Mobile friendly", "モバイル対応", "Mobilfreundlich", "Mobile friendly"),
        offlineCache = PublicText.T("Offline cache", "オフラインキャッシュ", "Offline-Cache", "Offline cache"),
        fallback = PublicText.T("fallback", "フォールバック", "Fallback", "fallback"),
        noAudioWarning = PublicText.T("Chưa có audio cho ngôn ngữ này.", "この言語の音声はまだありません。", "Für diese Sprache ist noch kein Audio verfügbar.", "No audio for this language yet."),
        ttsWarning = PublicText.T("Chưa có audio cho ngôn ngữ này. Đang dùng TTS.", "この言語の音声はまだありません。TTS を使用しています。", "Für diese Sprache ist noch kein Audio verfügbar. TTS wird verwendet.", "No audio for this language yet. Using TTS."),
        poiDetails = PublicText.T("Chi tiết POI", "POI 詳細", "POI-Details", "POI details"),
        close = PublicText.T("Đóng", "閉じる", "Schließen", "Close")
    }));
</script>

@page
@model TravelApp.Public.Web.Pages.IndexModel
@{
    ViewData["Title"] = Model.PageTitle;
    var text = PublicPageText.Current;
}

<section class="card hero-card" id="overview-panel">
    <div class="badge">@text.HeroBadge</div>
    <h1>@Model.PageTitle</h1>
    <p>@Model.PageSubtitle</p>

    <div class="hero-meta">
        @if (!string.IsNullOrWhiteSpace(Model.Poi?.Location))
        {
            <span>@Model.Poi.Location</span>
        }
        @if (Model.Poi is not null)
        {
            <span>@text.PoiLabel #@Model.Poi.Id</span>
        }
        @if (Model.Tour is not null)
        {
            <span>@text.TourLabel #@Model.Tour.Id</span>
        }
    </div>
</section>

<section class="card profile-card" id="profile-panel">
    <div class="section-head">
        <div>
            <h2>@text.Profile</h2>
            <p>@($"{text.CurrentLanguage}: {Model.CurrentLanguageDisplayText}")</p>
        </div>
        <span class="soft-badge">@text.MobileFriendly</span>
    </div>

    <div class="profile-stats">
        <div class="profile-stat">
            <span class="label">@text.CurrentLanguage</span>
            <strong>@Model.CurrentLanguageDisplayText</strong>
        </div>
        <div class="profile-stat">
            <span class="label">@text.Session</span>
            <strong id="public-session-id">—</strong>
        </div>
        <div class="profile-stat">
            <span class="label">@text.BookmarksCount</span>
            <strong id="public-bookmarks-count">0</strong>
        </div>
        <div class="profile-stat">
            <span class="label">@text.ListeningHistoryCount</span>
            <strong id="public-history-count">0</strong>
        </div>
    </div>

    <div class="profile-language-grid">
        @foreach (var culture in Model.Cultures)
        {
            <form asp-controller="Culture" asp-action="Set" method="post" class="culture-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="redirectUri" value="@($"{ViewContext.HttpContext.Request.Path}{ViewContext.HttpContext.Request.QueryString}")" />
                <button type="submit" name="culture" value="@culture.Code" class="culture-pill @(culture.IsSelected ? "active" : string.Empty)">
                    @culture.DisplayName
                </button>
            </form>
        }
    </div>

    <div class="profile-auth">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="profile-auth-card">
                <div>
                    <div class="profile-auth-kicker">@text.Account</div>
                    <strong>@(User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? User.Identity?.Name ?? text.Account)</strong>
                    <div class="muted">@(User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? string.Empty)</div>
                </div>
                <div class="profile-auth-actions">
                    <a class="map-action map-action-primary" asp-page="/Account/Index">@text.Account</a>
                    <form asp-page="/Auth/Logout" method="post">
                        <button type="submit" class="map-action">@text.Logout</button>
                    </form>
                </div>
            </div>
        }
        else
        {
            <div class="profile-auth-card">
                <div>
                    <div class="profile-auth-kicker">@text.Login</div>
                    <strong>@text.SignInToSyncBookmarksAndHistory</strong>
                    <div class="muted">@text.RegisterToKeepASeparateWebAccount</div>
                </div>
                <div class="profile-auth-actions">
                    <a class="map-action map-action-primary" asp-page="/Auth/Login" asp-route-returnUrl="@($"{ViewContext.HttpContext.Request.Path}{ViewContext.HttpContext.Request.QueryString}")">@text.Login</a>
                    <a class="map-action" asp-page="/Auth/Register" asp-route-returnUrl="@($"{ViewContext.HttpContext.Request.Path}{ViewContext.HttpContext.Request.QueryString}")">@text.Register</a>
                </div>
            </div>
        }
    </div>

</section>

<section class="card activity-card" id="activity-panel">
    <div class="section-head">
        <div>
            <h2>@text.BookmarksHistoryTitle</h2>
            <p>@text.BookmarksHistoryDescription</p>
        </div>
        <button type="button" class="map-action" id="activity-clear-button" data-history-clear>@text.ClearHistory</button>
    </div>

    <div class="activity-tabs" role="tablist" aria-label="@text.BookmarksHistoryTitle">
        <button type="button" class="activity-tab active" id="bookmarks-tab-button" data-activity-tab="bookmarks">@text.BookmarksTab <span class="activity-tab-count" id="bookmarks-tab-count">0</span></button>
        <button type="button" class="activity-tab" id="history-tab-button" data-activity-tab="history">@text.HistoryTab <span class="activity-tab-count" id="history-tab-count">0</span></button>
    </div>

    <div class="activity-view" id="bookmarks-view" data-activity-view="bookmarks">
        <div class="activity-list" id="bookmarks-list"></div>
        <div class="activity-empty" id="bookmarks-empty">@text.BookmarksTab — @text.PublicDataOnly</div>
    </div>

    <div class="activity-view" id="history-view" data-activity-view="history" hidden>
        <div class="activity-list" id="history-list"></div>
        <div class="activity-empty" id="history-empty">@text.HistoryTab — @text.PublicDataOnly</div>
    </div>
</section>

<div class="page-status" id="page-status" role="status" aria-live="polite">@text.LoadingPublicContent</div>
<div class="page-error" id="page-error" role="alert" hidden></div>

@if (Model.MapPoints.Any())
{
    <section class="map-layout" id="tour-map-panel">
        <div class="card map-card">
            <div class="section-head map-head">
                <div>
                    <h2>@text.MapTitle</h2>
                    <p>@text.MapDescription</p>
                </div>

                <div class="map-actions">
                    <a class="map-action" href="#poi-list">@text.ViewList</a>
                    <button type="button" class="map-action map-action-primary" id="route-open-button">@text.ViewRoute</button>
                </div>
            </div>

            <div id="tour-map" class="tour-map" aria-label="@text.MapAriaLabel"></div>
        </div>

        <aside class="card poi-list-card" id="poi-list">
            <div class="section-head">
                <h2>@text.PoiListTitle</h2>
                <p>@Model.MapPoints.Count @text.PoiInRoute</p>
            </div>

            <div class="poi-list" id="poi-list-items"></div>
        </aside>
    </section>

    <div class="poi-sheet" id="poi-sheet" aria-hidden="true">
        <div class="poi-sheet-handle"></div>
        <div class="poi-sheet-header">
            <div>
                <div class="poi-sheet-kicker">@text.PoiDetailsTitle</div>
                <h3 id="poi-sheet-title">-</h3>
                <p id="poi-sheet-subtitle" class="muted">-</p>
            </div>
            <button type="button" class="poi-sheet-close" id="poi-sheet-close" aria-label="@text.Close">×</button>
        </div>

        <div class="poi-sheet-meta" id="poi-sheet-meta"></div>

        <div class="poi-sheet-actions">
            <button type="button" class="primary-button" id="sheet-play-audio">@text.PlayAudio</button>
            <button type="button" class="primary-button" id="sheet-open-route">@text.OpenRoute</button>
            <button type="button" class="map-action" id="sheet-directions">@text.Directions</button>
        </div>

        <p class="audio-warning" id="poi-sheet-warning" hidden></p>
    </div>
}

@if (Model.Poi is null && Model.Tour is null)
{
    <section class="card home-hero-card" id="search-panel">
        <div class="home-hero-copy">
            <div class="badge">@text.HeroBadge</div>
            <h1>@Model.PageTitle</h1>
            <p>@Model.PageSubtitle</p>
        </div>

        <div class="home-quick-actions">
            <a class="quick-action" href="#featured-panel">@text.ViewList</a>
            <a class="quick-action" href="#tour-map-panel">@text.ViewRoute</a>
            <a class="quick-action" href="#audio-panel">@text.ListenAudio</a>
            <a class="quick-action" href="#activity-panel">@text.ListeningHistory</a>
        </div>

        <div class="home-search-wrap">
            <label class="home-search-label" for="home-search-input">@text.ViewList</label>
            <input id="home-search-input" class="home-search-input" type="search" placeholder="@text.ScanQrToOpenContent" autocomplete="off" />
        </div>
    </section>

    <section class="card" id="featured-panel">
        <div class="section-head">
            <div>
                <h2>@text.TourPublic</h2>
                <p>@text.PublicPageReceivesQr</p>
            </div>
            <span class="soft-badge">@text.MobileFriendly</span>
        </div>

        <div class="featured-tour-grid" id="home-featured-grid"></div>
        <div class="home-empty-state" id="home-empty-state" hidden>@text.PublicPageReceivesQr</div>
    </section>
}
else
{
    <section class="card detail-card">
        <div class="detail-media">
            <img src="@(Model.Poi?.ImageUrl ?? "https://placehold.co/1200x800/png?text=TravelApp")" alt="@Model.PageTitle" />
        </div>

        <div class="language-row">
            @foreach (var language in Model.Languages)
            {
                <a class="language-pill @(language.IsSelected ? "active" : string.Empty)" href="@Model.BuildLanguageUrl(language.Code)">@language.DisplayName</a>
            }
        </div>

        <div class="audio-panel" id="audio-panel">
            <div class="audio-panel-head">
                <div>
                <h2>@text.ListenAudio</h2>
                <p>@text.ChooseLanguagePlayAudio</p>
                </div>
                <span class="soft-badge">@Model.SelectedLanguageCode.ToUpperInvariant()</span>
            </div>

                @if (!string.IsNullOrWhiteSpace(Model.CurrentSpeechText))
                {
                    <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
                        <button type="button" class="primary-button" id="speak-button">@text.SpeakInBrowser</button>
                        <button type="button" class="map-action" id="bookmark-toggle-button">@text.BookmarkCurrent</button>
                        @if (Model.HasFallbackAudioBadge)
                        {
                            <span class="soft-badge">@text.FallbackBadge</span>
                        }
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.CurrentSpeechText))
                {
                    <div class="audio-secondary">
                        <label class="audio-secondary-label">@text.TtsContent</label>
                        <p class="muted" style="margin:0; white-space:pre-wrap;">@Model.CurrentSpeechText</p>
                    </div>
                }

                @if (Model.Tour is not null)
                {
                    <div style="display:flex; flex-wrap:wrap; gap:8px;">
                            <button type="button"
                                class="map-action map-action-primary"
                                id="auto-play-toggle"
                                aria-pressed="false">
                            @text.AutoPlayRouteOff
                        </button>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.CurrentAudioUrl))
                {
                    <div class="audio-secondary">
                        <label class="audio-secondary-label">@text.AudioOriginal</label>
                        <audio id="public-audio" controls preload="metadata" src="@Model.CurrentAudioUrl"></audio>
                    </div>
                }
                else if (string.IsNullOrWhiteSpace(Model.CurrentSpeechText))
                {
                    <p class="muted">@text.NoAudioForSelectedLanguage</p>
                }
                else
                {
                    <p class="muted">@text.AudioNotReadyForLanguage</p>
                }

            @if (!string.IsNullOrWhiteSpace(Model.AudioNoticeMessage))
            {
                <p class="audio-warning">@Model.AudioNoticeMessage</p>
            }
        </div>
    </section>

    @if (Model.Tour is not null)
    {
        <section class="card" id="history-panel">
            <div class="section-head">
            <h2>@text.TourPublic</h2>
            <p>@text.TapPoiForAudio</p>
            </div>

            <div class="waypoint-list">
                @foreach (var waypoint in Model.Waypoints)
                {
                    <a class="waypoint-item @(Model.IsCurrentPoi(waypoint.Poi.Id) ? "active" : string.Empty)" href="@Model.BuildPoiUrl(waypoint.Poi.Id)">
                        <div>
                            <strong>@waypoint.Poi.Title</strong>
                            <div class="muted">@waypoint.Poi.Subtitle</div>
                        </div>
                        <span>#@waypoint.SortOrder</span>
                    </a>
                }
            </div>
        </section>
    }

    <section class="card">
        <div class="section-head">
            <h2>@text.Notes</h2>
            <p>@text.NotesDescription</p>
        </div>
        <div class="soft-grid">
            <div class="soft-item">@text.PublicDataOnly</div>
            <div class="soft-item">@text.MobileFriendly</div>
            <div class="soft-item">@text.OfflineCache</div>
        </div>
    </section>
}


@using TravelApp.Application.Dtos.Pois
@model IReadOnlyList<PoiMobileDto>

@{
    ViewData["Title"] = AdminText.T("Quản lý POI", "POI 管理", "POI-Verwaltung");
}

@{
    var featuredPoi = Model.FirstOrDefault();
}

<div class="dashboard-grid">
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success">@successMessage</div>
    }

    <div class="section-header">
        <div>
            <h1 class="section-title">@AdminText.T("Quản lý POI", "POI 管理", "POI-Verwaltung")</h1>
            <p class="section-subtitle">@AdminText.T("Thêm, sửa, xóa POI và dùng ngay cho tour.", "POI の追加・編集・削除を行い、そのままツアーで利用できます。", "POIs hinzufügen, bearbeiten, löschen und direkt in Touren verwenden.")</p>
        </div>
        <div class="section-actions">
            <span class="soft-badge">@($"{Model.Count} {AdminText.T("POI", "POI", "POI")}")</span>
            <div class="poi-search">
                <input type="search" class="form-control" placeholder='@AdminText.T("Tìm POI...", "POI を検索...", "POI suchen...")' data-poi-search />
            </div>
            <form asp-action="BackfillSpeechTexts" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-primary">@AdminText.T("Bổ sung TTS", "TTS を補完", "TTS auffüllen")</button>
            </form>
            <a class="btn btn-primary" asp-action="Create">@AdminText.T("+ Tạo POI mới", "+ POI を作成", "+ POI erstellen")</a>
        </div>
    </div>

    <div class="admin-card p-4">
        <div class="section-header mb-3">
            <div>
                <h2 class="section-title">@AdminText.T("QR test nhanh", "クイック QR テスト", "Schneller QR-Test")</h2>
                <p class="section-subtitle">@AdminText.T("Dùng các mã này để test ngay trên app mobile hoặc emulator fallback.", "これらのコードでモバイルアプリまたはエミュレーターのフォールバックをすぐにテストできます。", "Mit diesen Codes lässt sich die Mobile-App oder der Emulator-Fallback sofort testen.")</p>
            </div>
        </div>

        @if (Model.Count == 0)
        {
            <div class="alert alert-info mb-0">@AdminText.T("Chưa có POI để tạo QR. Hãy tạo một POI trước.", "QR を作成する POI がありません。先に POI を作成してください。", "Noch keine POIs für QR-Codes vorhanden. Bitte zuerst einen POI erstellen.")</div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var poi in Model.Take(4))
                {
                    var qrContent = $"travelapp://poi/{poi.Id}";
                    var qrImageUrl = $"https://quickchart.io/qr?size=180&text={Uri.EscapeDataString(qrContent)}";
                    <div class="col-12 col-md-6 col-xl-3">
                        <div class="border rounded-4 bg-body-tertiary p-3 h-100">
                            <div class="d-flex align-items-start justify-content-between gap-2 mb-2">
                                <div>
                                    <div class="fw-semibold">@poi.Title</div>
                                    <div class="small text-muted">POI #@poi.Id</div>
                                </div>
                                <span class="soft-badge">QR</span>
                            </div>

                            <img src="@qrImageUrl" alt="QR for @poi.Title" class="img-fluid rounded-3 border bg-white p-2 mb-2" />

                            <div class="input-group input-group-sm">
                                <input type="text" class="form-control" readonly value="@qrContent" id="poi-qr-@poi.Id" />
                                <button type="button" class="btn btn-outline-primary" data-copy-text="#poi-qr-@poi.Id">@AdminText.T("Copy", "コピー", "Kopieren")</button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <div class="poi-grid">
        <div class="panel-card poi-table-card" data-poi-index>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>@AdminText.T("Title", "タイトル", "Titel")</th>
                            <th>@AdminText.T("Category", "カテゴリ", "Kategorie")</th>
                            <th>@AdminText.T("Location", "場所", "Ort")</th>
                            <th>@AdminText.T("Lang", "言語", "Sprache")</th>
                            <th class="text-end">@AdminText.T("Actions", "操作", "Aktionen")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var poi in Model)
                        {
                            <tr data-poi-row
                                data-search-text="@($"{poi.Title} {poi.Subtitle} {poi.Category} {poi.Location} {poi.PrimaryLanguage}")"
                                data-poi-title="@poi.Title"
                                data-poi-subtitle="@poi.Subtitle"
                                data-poi-image="@poi.ImageUrl"
                                data-poi-category="@poi.Category"
                                data-poi-language="@poi.PrimaryLanguage"
                                data-poi-location="@poi.Location"
                                data-poi-lat="@poi.Latitude"
                                data-poi-lng="@poi.Longitude"
                                data-poi-radius="@poi.GeofenceRadiusMeters"
                                data-poi-speech="@poi.SpeechText"
                                data-poi-speech-lang="@poi.SpeechTextLanguageCode"
                                data-poi-id="@poi.Id">
                                <td>
                                    <div class="fw-semibold">@poi.Title</div>
                                    <div class="small text-muted text-truncate" style="max-width: 280px;">@poi.Subtitle</div>
                                </td>
                                <td>@poi.Category</td>
                                <td>@poi.Location</td>
                                <td>@poi.PrimaryLanguage</td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-2 flex-wrap justify-content-end">
                                        <a class="btn btn-outline-light btn-sm" asp-controller="Tours" asp-action="AttachPoi" asp-route-poiId="@poi.Id">@AdminText.T("Dùng cho Tour", "ツアーに使う", "Für Tour verwenden")</a>
                                        <a class="btn btn-outline-light btn-sm" asp-controller="Tours" asp-action="AttachPoi" asp-route-poiId="@poi.Id">@AdminText.T("Gắn vào Tour hiện có", "既存のツアーに追加", "Zu bestehender Tour hinzufügen")</a>
                                        <a class="btn btn-outline-primary btn-sm" asp-action="Edit" asp-route-id="@poi.Id">@AdminText.T("Edit", "編集", "Bearbeiten")</a>
                                    @if (poi.IsUsedInTour)
                                    {
                                        <button type="button" class="btn btn-outline-danger btn-sm" disabled>@AdminText.T("Đang dùng trong Tour", "ツアーで使用中", "Wird in einer Tour verwendet")</button>
                                    }
                                    else
                                    {
                                        <form asp-action="Delete" asp-route-id="@poi.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-outline-danger btn-sm" onclick='return confirm("@AdminText.T("Xóa POI này?", "この POI を削除しますか？", "Diesen POI löschen?")");'>@AdminText.T("Delete", "削除", "Löschen")</button>
                                        </form>
                                    }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="preview-card poi-feature-card" data-poi-feature-card>
            <div class="preview-hero">
                <img src="@(string.IsNullOrWhiteSpace(featuredPoi?.ImageUrl) ? "https://placehold.co/800x600/png?text=POI+Preview" : featuredPoi!.ImageUrl)" alt="Featured POI" data-poi-preview="image" />
                <div class="preview-overlay"></div>
                <div class="preview-meta">
                    <div>
                        <div class="preview-title" data-poi-preview="title">@(featuredPoi?.Title ?? AdminText.T("Chưa có POI", "POI なし", "Noch kein POI"))</div>
                        <div class="preview-subtitle" data-poi-preview="subtitle">@(featuredPoi?.Subtitle ?? AdminText.T("Tạo POI đầu tiên để xem preview", "最初の POI を作成するとプレビューが表示されます", "Erstellen Sie zuerst einen POI, um die Vorschau zu sehen"))</div>
                    </div>
                    <span class="soft-badge" data-poi-preview="badge">@AdminText.T("Featured", "注目", "Vorgestellt")</span>
                </div>
            </div>
            <div class="poi-feature-footer">
                <div class="preview-stats">
                    <div class="preview-stat">
                        <div class="label">@AdminText.T("Category", "カテゴリ", "Kategorie")</div>
                        <div class="value" data-poi-preview="category">@(featuredPoi?.Category ?? "—")</div>
                    </div>
                    <div class="preview-stat">
                        <div class="label">@AdminText.T("Language", "言語", "Sprache")</div>
                        <div class="value" data-poi-preview="language">@(featuredPoi?.PrimaryLanguage ?? "—")</div>
                    </div>
                    <div class="preview-stat">
                        <div class="label">@AdminText.T("Radius", "半径", "Radius")</div>
                        <div class="value" data-poi-preview="radius">@(featuredPoi is null ? "—" : $"{featuredPoi.GeofenceRadiusMeters:0} m")</div>
                    </div>
                </div>

                <div class="mini-map mt-3">
                    <div class="mini-map-pin"></div>
                </div>

                <ul class="preview-list">
                    <li><span>@AdminText.T("Location", "場所", "Ort")</span><strong data-poi-preview="location">@(featuredPoi?.Location ?? "—")</strong></li>
                    <li><span>@AdminText.T("Lat / Lng", "緯度 / 経度", "Lat / Lng")</span><strong data-poi-preview="latlng">@(featuredPoi is null ? "—" : $"{featuredPoi.Latitude:0.0000}, {featuredPoi.Longitude:0.0000}")</strong></li>
                    <li><span>@AdminText.T("Speech", "読み上げ", "Speech")</span><strong data-poi-preview="speech">@(featuredPoi?.SpeechText ?? "—")</strong></li>
                    <li><span>@AdminText.T("Speech lang", "読み上げ言語", "Speech-Sprache")</span><strong data-poi-preview="speech-lang">@(featuredPoi?.SpeechTextLanguageCode ?? "—")</strong></li>
                </ul>
                <div class="poi-no-results mt-3" data-poi-no-results hidden>@AdminText.T("Không có POI nào khớp bộ lọc.", "フィルターに一致する POI がありません。", "Keine passenden POIs gefunden.")</div>
            </div>
        </div>
    </div>
</div>

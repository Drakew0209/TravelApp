@model TravelApp.Admin.Web.Models.Pois.PoiEditorViewModel

@{
    ViewData["Title"] = AdminText.T("Tạo POI", "POI を作成", "POI erstellen");
}

<div class="dashboard-grid">
    <div class="section-header">
        <div>
            <h1 class="section-title">@AdminText.T("Tạo POI mới", "新しい POI を作成", "Neuen POI erstellen")</h1>
            <p class="section-subtitle">@AdminText.T("POI mới sẽ xuất hiện ngay trong dropdown của Tour.", "新しい POI はツアーのドロップダウンにすぐ表示されます。", "Der neue POI erscheint sofort im Tour-Dropdown.")</p>
        </div>
        <div class="section-actions">
            <span class="soft-badge">@AdminText.T("POI • Create", "POI • 作成", "POI • Erstellen")</span>
        </div>
    </div>

    <form asp-action="Create" method="post" enctype="multipart/form-data" class="content-grid" data-live-preview-form>
        <div class="d-grid gap-4">
            <div class="admin-card p-4">
                <div class="section-header mb-3">
                    <div>
                        <h2 class="section-title">@AdminText.T("Thông tin cơ bản", "基本情報", "Grundinformationen")</h2>
                        <p class="section-subtitle">@AdminText.T("Tên, mô tả và ngôn ngữ hiển thị.", "名前、説明、表示言語。", "Name, Beschreibung und Anzeigesprache.")</p>
                    </div>
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Title" class="form-label">@AdminText.T("Title", "タイトル", "Titel")</label>
                        <input asp-for="Title" class="form-control" data-live-preview-input="Title" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Subtitle" class="form-label">@AdminText.T("Subtitle", "サブタイトル", "Untertitel")</label>
                        <input asp-for="Subtitle" class="form-control" data-live-preview-input="Subtitle" />
                    </div>
                    <div class="col-12">
                        <label asp-for="Description" class="form-label">@AdminText.T("Description", "説明", "Beschreibung")</label>
                        <textarea asp-for="Description" rows="4" class="form-control" readonly data-sync-description-from-speech="true" data-live-preview-input="Description"></textarea>
                        <div class="form-text">@AdminText.T("Tự đồng bộ từ Speech Text.", "Speech Text から自動同期されます。", "Wird automatisch aus dem Speech Text synchronisiert.")</div>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Category" class="form-label">@AdminText.T("Category", "カテゴリ", "Kategorie")</label>
                        <input asp-for="Category" class="form-control" data-live-preview-input="Category" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PrimaryLanguage" class="form-label">@AdminText.T("Primary language", "主要言語", "Primärsprache")</label>
                        <select asp-for="PrimaryLanguage" asp-items="Model.LanguageOptions" class="form-select" data-live-preview-input="PrimaryLanguage"></select>
                    </div>
                </div>
            </div>

            <div class="admin-card p-4">
                <div class="section-header mb-3">
                    <div>
                        <h2 class="section-title">@AdminText.T("Vị trí & hiển thị", "位置と表示", "Standort & Anzeige")</h2>
                        <p class="section-subtitle">@AdminText.T("Dùng cho bản đồ, geofence và ảnh đại diện.", "地図、ジオフェンス、サムネイルに使用します。", "Verwendet für Karte, Geofence und Vorschaubild.")</p>
                    </div>
                </div>
                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Location" class="form-label">@AdminText.T("Location", "場所", "Ort")</label>
                        <input asp-for="Location" class="form-control" data-live-preview-input="Location" />
                    </div>
                    <div class="col-12">
                        <label asp-for="ImageUrl" class="form-label">@AdminText.T("Image URL", "画像 URL", "Bild-URL")</label>
                        <details class="mt-1">
                            <summary class="form-text">@AdminText.T("URL ảnh (tùy chọn)", "画像 URL（任意）", "Bild-URL (optional)")</summary>
                            <input asp-for="ImageUrl" class="form-control mt-2" data-live-preview-input="ImageUrl" />
                        </details>
                        <div class="form-text">@AdminText.T("Ưu tiên chọn ảnh từ máy tính để hệ thống upload tự điền URL.", "できればローカル画像を選択してください。アップロード後に URL が自動入力されます。", "Bevorzugt ein lokales Bild auswählen; die Upload-URL wird automatisch eingetragen.")</div>
                        <input asp-for="ImageFile" type="file" accept="image/*" class="form-control mt-2" data-image-upload-input="true" data-image-upload-folder="pois" data-image-upload-target="ImageUrl" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Latitude" class="form-label">@AdminText.T("Latitude", "緯度", "Breitengrad")</label>
                        <input asp-for="Latitude" class="form-control" data-live-preview-input="Latitude" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Longitude" class="form-label">@AdminText.T("Longitude", "経度", "Längengrad")</label>
                        <input asp-for="Longitude" class="form-control" data-live-preview-input="Longitude" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="GeofenceRadiusMeters" class="form-label">@AdminText.T("Geofence radius", "ジオフェンス半径", "Geofence-Radius")</label>
                        <input asp-for="GeofenceRadiusMeters" class="form-control" data-live-preview-input="GeofenceRadiusMeters" />
                    </div>
                </div>
            </div>

            <div class="admin-card p-4 mb-4">
                <div class="accordion" id="poiContentAccordion">
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="poiLocalizationHeading">
                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#poiLocalizationCollapse" aria-expanded="true" aria-controls="poiLocalizationCollapse">
                                <span>
                                    <span class="d-block section-title" style="font-size: 16px;">@AdminText.T("Localizations", "ローカリゼーション", "Lokalisierungen")</span>
                                    <span class="d-block section-subtitle mb-0">@AdminText.T("Sửa tiêu đề, mô tả và subtitle theo từng ngôn ngữ.", "言語ごとにタイトル、説明、サブタイトルを編集します。", "Titel, Beschreibung und Untertitel pro Sprache bearbeiten.")</span>
                                </span>
                            </button>
                        </h2>
                        <div id="poiLocalizationCollapse" class="accordion-collapse collapse show" aria-labelledby="poiLocalizationHeading" data-bs-parent="#poiContentAccordion">
                            <div class="accordion-body pt-3">
                                <div id="poi-localization-rows" data-next-index="@Model.Localizations.Count">
                                    <div class="d-flex justify-content-end mb-3">
                                        <button type="button" class="btn btn-outline-primary btn-sm" data-add-row data-target="poi-localization-rows" data-prefix="Localizations">@AdminText.T("+ Add row", "+ 行を追加", "+ Zeile hinzufügen")</button>
                                    </div>
                                    @for (var i = 0; i < Model.Localizations.Count; i++)
                                    {
                                        <div class="row g-2 mb-3" data-repeat-row data-repeat-group="Localizations" data-localization-row="true">
                                            <div class="col-md-2"><select asp-for="Localizations[@i].LanguageCode" asp-items="Model.LanguageOptions" class="form-select" data-localization-language-select="true"></select></div>
                                            <div class="col-md-3"><input asp-for="Localizations[@i].Title" class="form-control" placeholder="@AdminText.T("Title", "タイトル", "Titel")" readonly data-localization-title-input="true" /></div>
                                            <div class="col-md-3"><input asp-for="Localizations[@i].Subtitle" class="form-control" placeholder="@AdminText.T("Subtitle", "サブタイトル", "Untertitel")" readonly data-localization-subtitle-input="true" /></div>
                                            <div class="col-md-4"><input asp-for="Localizations[@i].Description" class="form-control" placeholder="@AdminText.T("Description", "説明", "Beschreibung")" readonly data-localization-description="true" /></div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item">
                        <h2 class="accordion-header" id="poiLanguageAssetsHeading">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#poiLanguageAssetsCollapse" aria-expanded="false" aria-controls="poiLanguageAssetsCollapse">
                                <span>
                                    <span class="d-block section-title" style="font-size: 16px;">@AdminText.T("Language assets", "言語アセット", "Sprach-Assets")</span>
                                    <span class="d-block section-subtitle mb-0">@AdminText.T("Audio và speech text theo từng ngôn ngữ.", "言語ごとの音声と読み上げテキスト。", "Audio und Speech-Text pro Sprache.")</span>
                                </span>
                            </button>
                        </h2>
                        <div id="poiLanguageAssetsCollapse" class="accordion-collapse collapse" aria-labelledby="poiLanguageAssetsHeading" data-bs-parent="#poiContentAccordion">
                            <div class="accordion-body pt-3">
                                <div class="row g-4">
                                    <div class="col-12 col-xl-6">
                                        <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
                                            <div>
                                                <h3 class="section-title" style="font-size: 16px;">@AdminText.T("Audio assets", "音声アセット", "Audio-Assets")</h3>
                                                <p class="section-subtitle mb-0">@AdminText.T("Thêm audio trực tiếp cho POI theo từng ngôn ngữ.", "POI に言語別の音声を直接追加します。", "Audio direkt für den POI pro Sprache hinzufügen.")</p>
                                            </div>
                                            <button type="button" class="btn btn-outline-primary btn-sm" data-add-row data-target="poi-audio-rows" data-prefix="AudioAssets">@AdminText.T("+ Add row", "+ 行を追加", "+ Zeile hinzufügen")</button>
                                        </div>
                                        <div id="poi-audio-rows" data-next-index="@Model.AudioAssets.Count">
                                            @for (var i = 0; i < Model.AudioAssets.Count; i++)
                                            {
                                                <div class="row g-2 mb-3" data-repeat-row data-repeat-group="AudioAssets">
                                                    <div class="col-md-3"><select asp-for="AudioAssets[@i].LanguageCode" asp-items="Model.LanguageOptions" class="form-select"></select></div>
                                                    <div class="col-md-9"><input asp-for="AudioAssets[@i].AudioUrl" class="form-control" placeholder="@AdminText.T("Audio URL", "音声 URL", "Audio-URL")" /></div>
                                                    <div class="col-12 mt-2"><input asp-for="AudioAssets[@i].Transcript" class="form-control" placeholder="@AdminText.T("Transcript", "書き起こし", "Transkript")" /></div>
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <div class="col-12 col-xl-6">
                                        <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
                                            <div>
                                                <h3 class="section-title" style="font-size: 16px;">@AdminText.T("Speech texts", "読み上げテキスト", "Speech-Texte")</h3>
                                                <p class="section-subtitle mb-0">@AdminText.T("Nội dung speech theo từng ngôn ngữ.", "言語ごとの読み上げ内容。", "Speech-Inhalt pro Sprache.")</p>
                                            </div>
                                            <button type="button" class="btn btn-outline-primary btn-sm" data-add-row data-target="poi-speech-rows" data-prefix="SpeechTexts">@AdminText.T("+ Add row", "+ 行を追加", "+ Zeile hinzufügen")</button>
                                        </div>
                                        <div id="poi-speech-rows" data-next-index="@Model.SpeechTexts.Count">
                                            @for (var i = 0; i < Model.SpeechTexts.Count; i++)
                                            {
                                                <div class="row g-2 mb-3" data-repeat-row data-repeat-group="SpeechTexts" data-speech-text-row="true">
                                                    <div class="col-md-3"><select asp-for="SpeechTexts[@i].LanguageCode" asp-items="Model.LanguageOptions" class="form-select" data-speech-text-row-language="true"></select></div>
                                                    <div class="col-md-9"><textarea asp-for="SpeechTexts[@i].Text" rows="2" class="form-control" data-speech-text-row-text="true"></textarea></div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="preview-card sticky-top" style="top: 1rem;">
            <div class="preview-hero">
                <img data-live-preview="image" data-live-preview-source="ImageUrl" src="@(string.IsNullOrWhiteSpace(Model.ImageUrl) ? "https://placehold.co/800x600/png?text=POI+Preview" : Model.ImageUrl)" alt="POI preview" />
                <div class="preview-overlay"></div>
                <div class="preview-meta">
                    <div>
                        <div class="preview-title" data-live-preview="title" data-live-preview-source="Title">@(string.IsNullOrWhiteSpace(Model.Title) ? "POI Preview" : Model.Title)</div>
                        <div class="preview-subtitle" data-live-preview="subtitle" data-live-preview-source="Subtitle">@(string.IsNullOrWhiteSpace(Model.Subtitle) ? "Nhập thông tin để xem preview" : Model.Subtitle)</div>
                    </div>
                    <span class="soft-badge">@AdminText.T("Preview", "プレビュー", "Vorschau")</span>
                </div>
            </div>
            <div class="preview-body">
                <div class="preview-stats">
                    <div class="preview-stat">
                        <div class="label">@AdminText.T("Category", "カテゴリ", "Kategorie")</div>
                        <div class="value" data-live-preview="category" data-live-preview-source="Category">@(string.IsNullOrWhiteSpace(Model.Category) ? "—" : Model.Category)</div>
                    </div>
                    <div class="preview-stat">
                        <div class="label">@AdminText.T("Language", "言語", "Sprache")</div>
                        <div class="value" data-live-preview="language" data-live-preview-source="PrimaryLanguage">@(string.IsNullOrWhiteSpace(Model.PrimaryLanguage) ? "—" : Model.PrimaryLanguage)</div>
                    </div>
                    <div class="preview-stat">
                        <div class="label">@AdminText.T("Radius", "半径", "Radius")</div>
                        <div class="value" data-live-preview="radius" data-live-preview-source="GeofenceRadiusMeters" data-live-preview-format="meters">@($"{Model.GeofenceRadiusMeters:0} m")</div>
                    </div>
                    <div class="preview-stat">
                        <div class="label">@AdminText.T("Content", "コンテンツ", "Inhalt")</div>
                        <div class="value">@Model.Localizations.Count localizations · @Model.AudioAssets.Count audio · @Model.SpeechTexts.Count texts</div>
                    </div>
                </div>

                <div class="mini-map">
                    <div class="mini-map-pin"></div>
                </div>

                <ul class="preview-list">
                    <li><span>@AdminText.T("Location", "場所", "Ort")</span><strong data-live-preview="location" data-live-preview-source="Location">@(string.IsNullOrWhiteSpace(Model.Location) ? "—" : Model.Location)</strong></li>
                    <li><span>@AdminText.T("Lat / Lng", "緯度 / 経度", "Lat / Lng")</span><strong data-live-preview="latlng" data-live-preview-format="latlng">@($"{Model.Latitude:0.0000}, {Model.Longitude:0.0000}")</strong></li>
                    <li><span>@AdminText.T("Multi-language", "多言語", "Mehrsprachig")</span><strong>@(Model.Localizations.Count > 0 ? AdminText.T("Ready", "準備完了", "Bereit") : "—")</strong></li>
                </ul>

                <div class="d-grid gap-2 mt-4">
                    <button type="submit" class="btn btn-primary w-100">@AdminText.T("Lưu POI", "POI を保存", "POI speichern")</button>
                    <a asp-action="Index" class="btn btn-outline-light w-100">@AdminText.T("Hủy", "キャンセル", "Abbrechen")</a>
                </div>
            </div>
        </div>
    </form>
</div>

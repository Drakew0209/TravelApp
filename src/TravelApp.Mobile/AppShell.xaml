<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TravelApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:TravelApp"
    xmlns:strings="clr-namespace:TravelApp.Resources.Strings"
    Title="{x:Static strings:AppStrings.AppName}">

    <ShellContent
        x:Name="ExploreShellContent"
        Title="{x:Static strings:AppStrings.Explore}"
        ContentTemplate="{DataTemplate local:ExplorePage}"
        Route="ExplorePage" />

    <ShellContent
        x:Name="MapShellContent"
        Title="{x:Static strings:AppStrings.Map}"
        ContentTemplate="{DataTemplate local:MapPage}"
        Route="MapPage" />

</Shell>
